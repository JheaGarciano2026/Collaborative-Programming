   print("First Quarter Grade: ", Q1, "- Good")
elif Q1 <= 2.50:
   print("First Quarter Grade: ", Q1, "- Satisfactory")
elif Q1 <= 3.00:  
   print("First Quarter Grade: ", Q1, "- Fair")
elif Q1 <= 4.00:
   print("First Quarter Grade: ", Q1, "- Failed on condition")
else:  
   print("First Quarter Grade: ", Q1, "- Failed")

